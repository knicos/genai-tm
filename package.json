        "file-saver": "^2.0.5",
        "i18next": "^26.2.0",
        "i18next-browser-languagedetector": "^7.0.1",
        "i18next-http-backend": "^2.1.1",
        "jotai": "^2.12.4",
        "jszip": "^3.10.1",
        "lz-string": "^1.5.0",
        "peerjs": "^1.5.4",
        "qrcode": "^1.5.3",
        "react": "^19.2.8",
        "react-color": "^2.19.3",
        "react-dnd": "^16.0.1",
        "react-dnd-html5-backend": "^16.0.1",
